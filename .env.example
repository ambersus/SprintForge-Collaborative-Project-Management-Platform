# SprintForge — Environment Variables Template
# Copy this file to .env and fill in EVERY value before starting the application.
# NEVER commit .env to source control. It is already in .gitignore.
#
# Generate DJANGO_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# Generate POSTGRES_PASSWORD with:
#   openssl rand -base64 32

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,api.example.com
# Comma-separated list of the origins that can make cross-site requests to the API
CORS_ALLOWED_ORIGINS=https://example.com
# Comma-separated list of origins that Django will accept CSRF-protected forms from
CSRF_TRUSTED_ORIGINS=https://example.com,https://api.example.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=sprintforge
POSTGRES_USER=sprintforge
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Set to "memory" to use in-memory channel layer (development / CI only — NOT for production)
# CHANNEL_BACKEND=memory

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# These are baked into the frontend bundle at build time. They must point to the
# public-facing backend URL that browsers can reach.
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_WS_URL=wss://api.example.com

# ── Development overrides (SQLite — do NOT use in production) ─────────────────
# Uncomment to run the backend without a PostgreSQL server:
# DATABASE_ENGINE=django.db.backends.sqlite3
# SQLITE_NAME=db.sqlite3
# CHANNEL_BACKEND=memory
