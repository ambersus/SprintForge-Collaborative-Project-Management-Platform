# ─────────────────────────────────────────────────────────────
# SprintForge — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=unsafe-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
# Option A: SQLite (local development)
DATABASE_ENGINE=django.db.backends.sqlite3
SQLITE_NAME=db.sqlite3

# Option B: PostgreSQL via DATABASE_URL (Neon / Render / Docker)
# When DATABASE_URL is set, it takes priority over DATABASE_ENGINE.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option C: PostgreSQL via individual vars (Docker Compose)
# POSTGRES_DB=sprintforge
# POSTGRES_USER=sprintforge
# POSTGRES_PASSWORD=change-me-in-production
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── CORS / CSRF ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Django Channels ──────────────────────────────────────────
# Set to "memory" for local dev (no Redis needed).
# Remove or set a REDIS_URL for production with Redis.
CHANNEL_BACKEND=memory
# REDIS_URL=redis://redis:6379/0
